rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsStudentData(studentId) {
      return signedIn() && request.auth.uid == studentId;
    }

    match /users/{uid} {
      allow create: if ownsUser(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.role == "student";
      allow read: if isAdmin() || ownsUser(uid);
      allow update: if isAdmin() || (
        ownsUser(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "email"]) &&
        request.resource.data.role == resource.data.role
      );
      allow delete: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow create: if ownsStudentData(request.resource.data.studentId) &&
        request.resource.data.sessionId == sessionId;
      allow read: if isAdmin() || ownsStudentData(resource.data.studentId);
      allow update: if isAdmin() || (
        ownsStudentData(resource.data.studentId) &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "completedAt", "lastActivity", "totalViolations", "riskScore"]) &&
        request.resource.data.status in ["active", "completed"] &&
        request.resource.data.totalViolations >= resource.data.totalViolations &&
        request.resource.data.riskScore >= resource.data.riskScore
      );
      allow delete: if isAdmin();
    }

    match /logs/{logId} {
      allow create: if ownsStudentData(request.resource.data.studentId) &&
        request.resource.data.logId == logId &&
        request.resource.data.keys().hasAll([
          "logId",
          "sessionId",
          "studentId",
          "studentName",
          "violationType",
          "severity",
          "timestamp",
          "details"
        ]);
      allow read: if isAdmin() || ownsStudentData(resource.data.studentId);
      allow update, delete: if isAdmin();
    }
  }
}
