<resources>
    <style name="Theme.FocusShield.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B1020</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.FocusShield</item>
    </style>

    <style name="Theme.FocusShield" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>
    </style>
</resources>
